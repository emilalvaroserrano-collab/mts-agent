# MTS CSR Console — environment variables for Vercel

# LiveKit credentials (set as server environment variables in Vercel)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Enable anonymous guest support calls. Set to "true" only if you want
# unauthenticated visitors to be able to start support sessions.
CSR_ENABLE_GUEST_ACCESS=false

# Portal that redeems the signed-in customer handoff.
MTS_API_BASE_URL=https://mts.192-888-702-801.site


# Exact portal embedding origins, comma separated. This is public configuration.
NEXT_PUBLIC_MTS_PORTAL_ORIGINS=https://mts.192-888-702-801.site,https://access.virtualcloudgroup.com
